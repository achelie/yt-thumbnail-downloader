---
import Layout from '../layouts/Layout.astro';
import { translations } from '../i18n/index';
import { pagePath } from '../i18n/routes';
import type { Locale, PageId } from '../i18n/types';
interface Props { locale: Locale; page: Exclude<PageId, 'home'>; }
const { locale, page } = Astro.props;
const t = translations[locale];
const content = page === 'notFound' ? t.notFound : t.documents[page];
const document = page === 'notFound' ? undefined : t.documents[page];
---
<Layout title={content.title} description={content.description} locale={locale} page={page}>
  <section class="document-page">
    <a class="back-link" href={pagePath(locale)}>← {t.nav.back}</a>
    <p class="eyebrow">{content.eyebrow}</p>
    <h1>{content.h1}</h1>
    <p class="document-lead">{content.lead}</p>
    {document?.sections.map((section) => <>
      <h2>{section.heading}</h2>
      {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      {section.link && <p><a href={section.link.url} target="_blank" rel="noopener noreferrer">{section.link.label}</a></p>}
    </>)}
    {page !== 'notFound' && <p class="document-related"><a href={pagePath(locale, 'privacy')}>{t.nav.privacy}</a> · <a href={pagePath(locale, 'terms')}>{t.nav.terms}</a></p>}
    {document?.updated && <p class="document-updated">{document.updated}</p>}
  </section>
</Layout>
