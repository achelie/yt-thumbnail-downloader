{
  "name": "yt-thumbnail-downloader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "astro build && node --experimental-strip-types scripts/postbuild.ts",
    "preview": "wrangler dev --ip 127.0.0.1 --port 4322",
    "audit": "node --experimental-strip-types scripts/audit.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": { "astro": "7.3.5" },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^22.0.0",
    "sharp": "^0.34.0",
    "typescript": "5.9.3",
    "wrangler": "4.145.0"
  }
}
